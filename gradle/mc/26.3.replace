re:\bcom\.mojang\.blaze3d\.vulkan\.VulkanPhysicalDevice\b => com.mojang.renderpearl.backend.vulkan.VulkanPhysicalDevice
re:\bcom\.mojang\.blaze3d\.vulkan\.VulkanRenderPipeline\b => com.mojang.renderpearl.backend.vulkan.VulkanRenderPipeline
re:\bcom\.mojang\.blaze3d\.pipeline\.DepthStencilState\b => com.mojang.renderpearl.api.pipeline.DepthStencilState
re:\bcom\.mojang\.blaze3d\.vertex\.VertexFormatElement\b => com.mojang.renderpearl.api.vertex.VertexFormatElement
re:\bcom\.mojang\.blaze3d\.pipeline\.ColorTargetState\b => com.mojang.renderpearl.api.pipeline.ColorTargetState
