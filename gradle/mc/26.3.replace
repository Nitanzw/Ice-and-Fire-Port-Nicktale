re:\bcom\.mojang\.blaze3d\.opengl\.FrameBufferCache\b => com.mojang.renderpearl.backend.opengl.FrameBufferCache
re:\bcom\.mojang\.blaze3d\.opengl\.GlCommandEncoder\b => com.mojang.renderpearl.backend.opengl.GlCommandEncoder
re:\bcom\.mojang\.blaze3d\.opengl\.GlRenderPipeline\b => com.mojang.renderpearl.backend.opengl.GlRenderPipeline
re:\bcom\.mojang\.blaze3d\.pipeline\.RenderPipeline\b => com.mojang.renderpearl.api.pipeline.RenderPipeline
