re:\bcom\.mojang\.blaze3d\.vulkan\.VulkanInstance\b => com.mojang.renderpearl.backend.vulkan.VulkanInstance
re:\bcom\.mojang\.blaze3d\.opengl\.BufferStorage\b => com.mojang.renderpearl.backend.opengl.BufferStorage
re:\bcom\.mojang\.blaze3d\.opengl\.GlTextureView\b => com.mojang.renderpearl.backend.opengl.GlTextureView
re:\bcom\.mojang\.blaze3d\.platform\.BlendFactor\b => com.mojang.renderpearl.api.pipeline.BlendFactor
re:\bcom\.mojang\.blaze3d\.platform\.PolygonMode\b => com.mojang.renderpearl.api.pipeline.PolygonMode
re:\bcom\.mojang\.blaze3d\.shaders\.ShaderSource\b => com.mojang.renderpearl.api.pipeline.ShaderSource
re:\bcom\.mojang\.blaze3d\.systems\.DeviceLimits\b => com.mojang.renderpearl.api.device.DeviceLimits
re:\bcom\.mojang\.blaze3d\.systems\.GpuQueryPool\b => com.mojang.renderpearl.api.commands.GpuQueryPool
re:\bcom\.mojang\.blaze3d\.textures\.AddressMode\b => com.mojang.renderpearl.api.textures.AddressMode
re:\bcom\.mojang\.blaze3d\.vulkan\.VulkanBackend\b => com.mojang.renderpearl.backend.vulkan.VulkanBackend
