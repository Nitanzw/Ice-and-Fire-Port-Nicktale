re:\bcom\.mojang\.blaze3d\.opengl\.DirectStateAccess\b => com.mojang.renderpearl.backend.opengl.DirectStateAccess
re:\bcom\.mojang\.blaze3d\.opengl\.GlTransientMemory\b => com.mojang.renderpearl.backend.opengl.GlTransientMemory
re:\bcom\.mojang\.blaze3d\.pipeline\.BindGroupLayout\b => com.mojang.renderpearl.api.pipeline.BindGroupLayout
re:\bcom\.mojang\.blaze3d\.systems\.GpuDeviceBackend\b => com.mojang.renderpearl.backend.api.GpuDeviceBackend
re:\bcom\.mojang\.blaze3d\.systems\.SurfaceException\b => com.mojang.renderpearl.api.device.SurfaceException
re:\bcom\.mojang\.blaze3d\.systems\.TracyGpuProfiler\b => com.mojang.renderpearl.frontend.TracyGpuProfiler
re:\bcom\.mojang\.blaze3d\.vulkan\.VulkanCommandPool\b => com.mojang.renderpearl.backend.vulkan.VulkanCommandPool
