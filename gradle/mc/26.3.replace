# Reglas de fuente 26.2 -> 26.3 aplicadas por mc-preprocess.gradle (literal; prefijo "re:" = regex).
# Clases de render movidas de com.mojang.blaze3d a com.mojang.renderpearl:
re:\bcom\.mojang\.blaze3d\.vulkan\.checkpoints\.AbstractCheckpointStorage\b => com.mojang.renderpearl.backend.vulkan.checkpoints.AbstractCheckpointStorage
re:\bcom\.mojang\.blaze3d\.vulkan\.checkpoints\.NvidiaCheckpointExtension\b => com.mojang.renderpearl.backend.vulkan.checkpoints.NvidiaCheckpointExtension
re:\bcom\.mojang\.blaze3d\.vulkan\.checkpoints\.NoopCheckpointExtension\b => com.mojang.renderpearl.backend.vulkan.checkpoints.NoopCheckpointExtension
re:\bcom\.mojang\.blaze3d\.vulkan\.checkpoints\.AmdCheckpointExtension\b => com.mojang.renderpearl.backend.vulkan.checkpoints.AmdCheckpointExtension
re:\bcom\.mojang\.blaze3d\.vulkan\.checkpoints\.CheckpointExtension\b => com.mojang.renderpearl.backend.vulkan.checkpoints.CheckpointExtension
re:\bcom\.mojang\.blaze3d\.vulkan\.glsl\.ShaderCompileException\b => com.mojang.renderpearl.util.ShaderCompileException
re:\bcom\.mojang\.blaze3d\.systems\.BackendCreationException\b => com.mojang.renderpearl.api.device.BackendCreationException
re:\bcom\.mojang\.blaze3d\.pipeline\.CompiledRenderPipeline\b => com.mojang.renderpearl.api.pipeline.CompiledRenderPipeline
re:\bcom\.mojang\.blaze3d\.systems\.CommandEncoderBackend\b => com.mojang.renderpearl.backend.api.CommandEncoderBackend
re:\bcom\.mojang\.blaze3d\.vulkan\.init\.VulkanPNextStruct\b => com.mojang.renderpearl.backend.vulkan.init.VulkanPNextStruct
re:\bcom\.mojang\.blaze3d\.opengl\.FrameBufferAttachment\b => com.mojang.renderpearl.backend.opengl.FrameBufferAttachment
re:\bcom\.mojang\.blaze3d\.systems\.RenderPassDescriptor\b => com.mojang.renderpearl.api.commands.RenderPassDescriptor
re:\bcom\.mojang\.blaze3d\.util\.TransientBlockAllocator\b => com.mojang.renderpearl.backend.util.TransientBlockAllocator
re:\bcom\.mojang\.blaze3d\.vulkan\.VulkanTransientMemory\b => com.mojang.renderpearl.backend.vulkan.VulkanTransientMemory
re:\bcom\.mojang\.blaze3d\.systems\.HintsAndWorkarounds\b => com.mojang.renderpearl.api.device.HintsAndWorkarounds
re:\bcom\.mojang\.blaze3d\.vulkan\.VulkanCommandEncoder\b => com.mojang.renderpearl.backend.vulkan.VulkanCommandEncoder
