re:\bcom\.mojang\.blaze3d\.vulkan\.DestructionQueue\b => com.mojang.renderpearl.backend.vulkan.DestructionQueue
re:\bcom\.mojang\.blaze3d\.vulkan\.VulkanGpuSampler\b => com.mojang.renderpearl.backend.vulkan.VulkanGpuSampler
re:\bcom\.mojang\.blaze3d\.vulkan\.VulkanGpuSurface\b => com.mojang.renderpearl.backend.vulkan.VulkanGpuSurface
re:\bcom\.mojang\.blaze3d\.vulkan\.VulkanGpuTexture\b => com.mojang.renderpearl.backend.vulkan.VulkanGpuTexture
re:\bcom\.mojang\.blaze3d\.vulkan\.VulkanRenderPass\b => com.mojang.renderpearl.backend.vulkan.VulkanRenderPass
re:\bcom\.mojang\.blaze3d\.GpuDeviceLossException\b => com.mojang.renderpearl.api.device.GpuDeviceLossException
re:\bcom\.mojang\.blaze3d\.buffers\.GpuBufferSlice\b => com.mojang.renderpearl.api.buffers.GpuBufferSlice
re:\bcom\.mojang\.blaze3d\.pipeline\.BlendEquation\b => com.mojang.renderpearl.api.pipeline.BlendEquation
re:\bcom\.mojang\.blaze3d\.pipeline\.BlendFunction\b => com.mojang.renderpearl.api.pipeline.BlendFunction
re:\bcom\.mojang\.blaze3d\.systems\.CommandEncoder\b => com.mojang.renderpearl.api.commands.CommandEncoder
re:\bcom\.mojang\.blaze3d\.systems\.DeviceFeatures\b => com.mojang.renderpearl.api.device.DeviceFeatures
re:\bcom\.mojang\.blaze3d\.vulkan\.VulkanGpuBuffer\b => com.mojang.renderpearl.backend.vulkan.VulkanGpuBuffer
re:\bcom\.mojang\.blaze3d\.vulkan\.VulkanQueryPool\b => com.mojang.renderpearl.backend.vulkan.VulkanQueryPool
re:\bcom\.mojang\.blaze3d\.opengl\.GlShaderModule\b => com.mojang.renderpearl.backend.opengl.GlShaderModule
